{
  "name": "novastat-server",
  "version": "1.0.0",
  "description": "Full-Stack File Upload and Processing Management System - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/modules/processing/worker.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@bull-board/api": "^9.12.0",
    "@bull-board/express": "^9.12.0",
    "@napi-rs/canvas": "^0.1.80",
