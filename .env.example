# Novastat Full-Stack Environment Variables

# PostgreSQL Database Configuration
POSTGRES_USER=novastat
POSTGRES_PASSWORD=novastat_password
POSTGRES_DB=novastat_db
POSTGRES_PORT=5432

# Backend Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://novastat:novastat_password@localhost:5432/novastat_db?schema=public"
JWT_SECRET="novastat_jwt_secure_secret_key_production_grade_32_chars"
JWT_EXPIRES_IN="7d"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES="application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,image/png,image/jpeg"
CLIENT_URL="http://localhost:5173"

REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=2
# OCR uses pdfjs-dist for internal rendering and Tesseract.js.
OCR_COMMAND=internal

# Frontend Vite Configuration
VITE_API_URL="/api/v1"

