# Novastat Full-Stack Environment Variables

# PostgreSQL Database Configuration
POSTGRES_USER=novastat
POSTGRES_PASSWORD=novastat_password
POSTGRES_DB=novastat_db
POSTGRES_PORT=5432

# Backend Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://novastat:novastat_password@localhost:5432/novastat_db?schema=public"
JWT_SECRET="novastat_jwt_secure_secret_key_production_grade_32_chars"
JWT_EXPIRES_IN="7d"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp,application/pdf,application/zip,text/plain,application/json,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
CLIENT_URL="http://localhost:5173"

# Frontend Vite Configuration
VITE_API_URL="/api/v1"

