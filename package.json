{
  "name": "novastat-root",
  "version": "1.0.0",
  "description": "Full-Stack File Upload and Processing Management System",
  "private": true,
  "scripts": {
    "server:install": "npm --prefix server install",
    "client:install": "npm --prefix client install",
    "install:all": "npm run server:install && npm run client:install",
    "test": "npm --prefix server test",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  }
}

